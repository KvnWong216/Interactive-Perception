(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the bbq sauce in the wicker basket.)
  (:regions
    (fridge_region
      (:target main_table)
      (:ranges ((0.02 -0.16 0.04 -0.14)))
      (:yaw_rotation ((1.5707963267948966 1.5707963267948966))))
    (basket_region
      (:target main_table)
      (:ranges ((0.05 0.19 0.07 0.21))))
    (middle_region (:target short_fridge_1))
    (contain_region (:target basket_1)))
  (:fixtures
    main_table - table
    short_fridge_1 - short_fridge)
  (:objects
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket)
  (:obj_of_interest
    bbq_sauce_1
    basket_1
    short_fridge_1)
  (:init
    (In bbq_sauce_1 short_fridge_1_middle_region)
    (Close short_fridge_1)
    (On basket_1 main_table_basket_region)
    (On short_fridge_1 main_table_fridge_region))
  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))))
