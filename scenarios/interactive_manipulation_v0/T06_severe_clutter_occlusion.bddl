(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the ketchup in the wicker basket.)
  (:regions
    (ketchup_region (:target main_table) (:ranges ((-0.30 0.12 -0.28 0.14))))
    (soup_region (:target main_table) (:ranges ((-0.18 0.12 -0.16 0.14))))
    (sauce_region (:target main_table) (:ranges ((-0.05 0.12 -0.03 0.14))))
    (milk_region (:target main_table) (:ranges ((0.08 0.12 0.10 0.14))))
    (juice_region (:target main_table) (:ranges ((-0.30 -0.15 -0.28 -0.13))))
    (bbq_region (:target main_table) (:ranges ((-0.17 -0.15 -0.15 -0.13))))
    (cheese_region (:target main_table) (:ranges ((-0.04 -0.15 -0.02 -0.13))))
    (pudding_region (:target main_table) (:ranges ((0.09 -0.15 0.11 -0.13))))
    (cookies_region (:target main_table) (:ranges ((0.22 -0.15 0.24 -0.13))))
    (basket_region (:target main_table) (:ranges ((0.08 0.20 0.10 0.22))))
    (contain_region (:target basket_1))
  )
  (:fixtures main_table - table)
  (:objects
    ketchup_1 - ketchup
    alphabet_soup_1 - alphabet_soup
    tomato_sauce_1 - tomato_sauce
    milk_1 - milk
    orange_juice_1 - orange_juice
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    basket_1 - basket
  )
  (:obj_of_interest ketchup_1 basket_1)
  (:init
    (On ketchup_1 main_table_ketchup_region)
    (On alphabet_soup_1 main_table_soup_region)
    (On tomato_sauce_1 main_table_sauce_region)
    (On milk_1 main_table_milk_region)
    (On orange_juice_1 main_table_juice_region)
    (On bbq_sauce_1 main_table_bbq_region)
    (On cream_cheese_1 main_table_cheese_region)
    (On chocolate_pudding_1 main_table_pudding_region)
    (On cookies_1 main_table_cookies_region)
    (On basket_1 main_table_basket_region)
  )
  (:goal (And (In ketchup_1 basket_1_contain_region)))
)
