(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the alphabet soup can in the wicker basket.)
  (:regions
    (target_region
      (:target main_table)
      (:ranges ((-0.08 0.02 -0.06 0.04)))
    )
    (basket_region
      (:target main_table)
      (:ranges ((0.08 0.20 0.10 0.22)))
    )
    (distractor_region
      (:target main_table)
      (:ranges ((-0.22 0.20 -0.20 0.22)))
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    main_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_1
  )

  (:init
    (On alphabet_soup_1 main_table_target_region)
    (On basket_1 main_table_basket_region)
    (On tomato_sauce_1 main_table_distractor_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )
)
