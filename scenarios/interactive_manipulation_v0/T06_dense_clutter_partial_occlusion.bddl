(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the ketchup in the wicker basket.)
  (:regions
    (ketchup_region
      (:target main_table)
      (:ranges ((-0.15 -0.07 -0.13 -0.05)))
    )
    (alphabet_soup_region
      (:target main_table)
      (:ranges ((-0.08 -0.07 -0.07 -0.05)))
    )
    (tomato_sauce_region
      (:target main_table)
      (:ranges ((-0.04 0.00 -0.02 0.02)))
    )
    (milk_region
      (:target main_table)
      (:ranges ((-0.15 0.02 -0.13 0.04)))
    )
    (orange_juice_region
      (:target main_table)
      (:ranges ((-0.04 -0.16 -0.02 -0.14)))
    )
    (bbq_sauce_region
      (:target main_table)
      (:ranges ((-0.17 -0.16 -0.15 -0.14)))
    )
    (basket_region
      (:target main_table)
      (:ranges ((0.08 0.20 0.10 0.22)))
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    main_table - table
  )

  (:objects
    ketchup_1 - ketchup
    alphabet_soup_1 - alphabet_soup
    tomato_sauce_1 - tomato_sauce
    milk_1 - milk
    orange_juice_1 - orange_juice
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On ketchup_1 main_table_ketchup_region)
    (On alphabet_soup_1 main_table_alphabet_soup_region)
    (On tomato_sauce_1 main_table_tomato_sauce_region)
    (On milk_1 main_table_milk_region)
    (On orange_juice_1 main_table_orange_juice_region)
    (On bbq_sauce_1 main_table_bbq_sauce_region)
    (On basket_1 main_table_basket_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )
)
