(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the orange juice in the wicker basket.)
  (:regions
    (fridge_region
      (:target main_table)
      (:ranges ((-0.01 -0.31 0.01 -0.29)))
      (:yaw_rotation ((3.141592653589793 3.141592653589793)))
    )
    (basket_region
      (:target main_table)
      (:ranges ((0.05 0.19 0.07 0.21)))
    )
    (middle_region
      (:target short_fridge_1)
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    main_table - table
    short_fridge_1 - short_fridge
  )

  (:objects
    orange_juice_1 - orange_juice
    basket_1 - basket
  )

  (:obj_of_interest
    orange_juice_1
    basket_1
    short_fridge_1
  )

  (:init
    (In orange_juice_1 short_fridge_1_middle_region)
    (Close short_fridge_1)
    (On basket_1 main_table_basket_region)
    (On short_fridge_1 main_table_fridge_region)
  )

  (:goal
    (And (In orange_juice_1 basket_1_contain_region))
  )
)
