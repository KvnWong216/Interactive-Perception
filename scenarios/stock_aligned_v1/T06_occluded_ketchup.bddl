(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup and place it in the basket)
  (:regions
    (bin_region (:target floor) (:ranges ((-0.01 0.25 0.01 0.27))))
    (target_object_region (:target floor) (:ranges ((-0.145 -0.265 -0.095 -0.215))))
    (other_object_region_0 (:target floor) (:ranges ((0.025 -0.125 0.075 -0.075))))
    (other_object_region_1 (:target floor) (:ranges ((-0.175 0.035 -0.125 0.085))))
    (other_object_region_2 (:target floor) (:ranges ((0.075 -0.225 0.125 -0.175))))
    (other_object_region_3 (:target floor) (:ranges ((0.125 0.005 0.175 0.055))))
    ; The only intervention relative to libero_object task 4: milk is placed
    ; on the stock target-to-camera ray. The target, basket, other objects,
    ; robot, cameras, controller, and prompt are unchanged.
    (occluder_region (:target floor) (:ranges ((-0.108 -0.203 -0.107 -0.202))))
    (contain_region (:target basket_1))
  )
  (:fixtures floor - floor)
  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    salad_dressing_1 - salad_dressing
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    milk_1 - milk
  )
  (:obj_of_interest ketchup_1 basket_1)
  (:init
    (On ketchup_1 floor_target_object_region)
    (On bbq_sauce_1 floor_other_object_region_0)
    (On salad_dressing_1 floor_other_object_region_1)
    (On alphabet_soup_1 floor_other_object_region_2)
    (On cream_cheese_1 floor_other_object_region_3)
    (On milk_1 floor_occluder_region)
    (On basket_1 floor_bin_region)
  )
  (:goal (And (In ketchup_1 basket_1_contain_region)))
)
