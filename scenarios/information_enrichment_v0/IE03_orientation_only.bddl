(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the bottle labeled Tomato Ketchup in the wicker basket.)
  (:regions
    (ketchup_region (:target main_table) (:ranges ((0.12 -0.07 0.14 -0.05))))
    (bbq_region (:target main_table) (:ranges ((0.20 0.06 0.22 0.08))))
    (basket_region (:target main_table) (:ranges ((0.36 0.20 0.38 0.22))))
    (contain_region (:target basket_1))
  )
  (:fixtures
    main_table - table
  )
  (:objects
    ketchup_1 - ketchup
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket
  )
  (:obj_of_interest
    ketchup_1
    basket_1
  )
  (:init
    (On ketchup_1 main_table_ketchup_region)
    (On bbq_sauce_1 main_table_bbq_region)
    (On basket_1 main_table_basket_region)
  )
  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )
)
