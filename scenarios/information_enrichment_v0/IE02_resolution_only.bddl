(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the package labeled Macaroni and Cheese in the wicker basket.)
  (:regions
    (macaroni_region (:target main_table) (:ranges ((0.27 -0.10 0.29 -0.08))))
    (pudding_region (:target main_table) (:ranges ((0.33 0.00 0.35 0.02))))
    (cream_cheese_region (:target main_table) (:ranges ((0.27 0.10 0.29 0.12))))
    (basket_region (:target main_table) (:ranges ((0.38 0.20 0.40 0.22))))
    (contain_region (:target basket_1))
  )
  (:fixtures
    main_table - table
  )
  (:objects
    macaroni_and_cheese_1 - macaroni_and_cheese
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
    basket_1 - basket
  )
  (:obj_of_interest
    macaroni_and_cheese_1
    basket_1
  )
  (:init
    (On macaroni_and_cheese_1 main_table_macaroni_region)
    (On chocolate_pudding_1 main_table_pudding_region)
    (On cream_cheese_1 main_table_cream_cheese_region)
    (On basket_1 main_table_basket_region)
  )
  (:goal
    (And (In macaroni_and_cheese_1 basket_1_contain_region))
  )
)
